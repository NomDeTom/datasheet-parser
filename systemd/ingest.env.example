# ~/.config/autonotes/ingest.env — read by the autonotes-* systemd user units.
# The AutoNotes folder (the one holding Library/ and "Import files/").
AUTONOTES_VAULT=/path/to/AutoNotes
# Python of the venv that has Docling installed (see README).
DOCLING_PYTHON=/path/to/docling-venv/bin/python
HF_HUB_OFFLINE=1
OMP_NUM_THREADS=4
# Use a disk-backed temp dir if /tmp is RAM-backed.
TMPDIR=/var/tmp
# Documents longer than this get pypdf text at import and Docling in the nightly run.
INGEST_MAX_PAGES=250
# OCR for PDFs without a text layer (scans, outline text): 1 = on (needs RapidOCR +
# onnxruntime in the Docling venv), 0 = off (such documents are only flagged no_text_layer).
INGEST_OCR=1
# Seconds a file must stop growing before it is picked up (sync tools write in pieces).
INGEST_SETTLE_SECONDS=20
