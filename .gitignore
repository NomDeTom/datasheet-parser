# Local staging folders (input/datasheets/ is parse.py --all's default). Contents stay
# local; the folders themselves are kept (.gitkeep).
input/*/*
!input/*/.gitkeep
processed/
output/*
!output/.gitkeep

.venv/
__pycache__/
*.pyc

# Machine-local vault location override (see vaultpath.py); the vault itself lives outside the repo.
.autonotes-vault
